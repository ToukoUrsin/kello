{
 "schema": 4,
 "question": "B. Is this measure already running in South Ostrobothnia wellbeing services county (or in the Tays university hospital area that treats its patients)?\nA. Does recent evidence support the size of effect we assume: does this measure shorten the time from first symptom to treatment start for lung cancer patients, and by how many days?\nMeasure: Same-day chest X-ray report with immediate CT. A radiologist or reporting radiographer reads primary-care chest X-rays while the patient waits; if suspicious, CT is done the same day or within days and the referral is triggered by radiology.",
 "area_id": "16",
 "verdict": "supported",
 "effect_check": "supports",
 "effect_summary_en": "",
 "supported_en": "The Thorax 2023 trial (radioX) found a median saving of 31 days from chest X-ray to lung cancer diagnosis (32 vs 63 days).",
 "not_supported_en": "The trial gives no confidence interval and was done in a single London hospital, and it measures time to diagnosis, not to the start of treatment.",
 "in_use_here": "no_evidence",
 "in_use_scope": "none",
 "in_use_quote": null,
